def check_new_jobs():

    print("[Notifier] checking jobs")


    users = get_users_with_alerts()


    for user in users:

        collectors = get_collectors(
            user.country
        )


        jobs=[]

        for collector in collectors:

            try:
                jobs.extend(
                    collector.fetch_jobs(user)
                )

            except Exception as e:
                print(
                    collector.source,
                    e
                )


